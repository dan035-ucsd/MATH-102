{
	"Display Math": {
		"scope": "latex",
		"prefix": ["dmk","dkm"],
		"body": [
			"\\begin{align*}",
			"\t${1:math}",
			"\\end{align*}$0"
		],
		"description": "Insert display math"
	},

	"Environment": {
		"scope": "latex",
		"prefix": "beg",
		"body": [
			"\\begin{${1:env}}",
			"\t$0",
			"\\end{${1:env}}"
		],
		"description": "Begin an environment"
	},

	"Fraction": {
		"scope": "latex",
		"prefix": "frac",
		"body": [
			"\\frac{${1:numerator}}{${2:denominator}}$0"
		],
		"description": "Insert a fraction"
	},

	"Inline Math": {
		"scope": "latex",
		"prefix": ["mk","km"],
		"body": [
			"$${1:math}$$0"
		],
		"description": "Insert inline math"
	},

	"Math Blackboard Bold": {
		"scope": "latex",
		"prefix": "bb",
		"body": [
			"\\mathbb{${1:letter}}$0"
		],
		"description": "Insert math blackboard bold text"
	},

	"Math Calligraphy": {
		"scope": "latex",
		"prefix": "cal",
		"body": [
			"\\mathcal{${1:letter}}$0"
		],
		"description": "Insert math calligraphy text"
	},
	
	"Vectors": {
		"scope": "latex",
		"prefix": "vec",
		"body": [
			"\\vec{${1:vector}}$0"
		],
		"description": "Insert a vector"
	}
	// Place your MATH workspace snippets here. Each snippet is defined under a snippet name and has a scope, prefix, body and 
	// description. Add comma separated ids of the languages where the snippet is applicable in the scope field. If scope 
	// is left empty or omitted, the snippet gets applied to all languages. The prefix is what is 
	// used to trigger the snippet and the body will be expanded and inserted. Possible variables are: 
	// $1, $2 for tab stops, $0 for the final cursor position, and ${1:label}, ${2:another} for placeholders. 
	// Placeholders with the same ids are connected.
